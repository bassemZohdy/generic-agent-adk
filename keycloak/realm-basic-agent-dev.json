{
  "realm": "basic-agent",
  "enabled": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {"name": "agent-user"},
      {"name": "agent-operator"}
    ]
  },
  "clients": [
    {
      "clientId": "basic-agent",
      "name": "Basic ADK Agent (development)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8003/*"],
      "webOrigins": ["http://localhost:8003"]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": ["agent-user", "agent-operator"]
    }
  ]
}
