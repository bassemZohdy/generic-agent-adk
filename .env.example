# ── Minimal agent configuration ─────────────────────────────────────────────
# Agent construction needs only a provider key. HTTP access still requires
# Keycloak, or an explicit AUTH_DISABLED=true opt-in for an intentionally local,
# unauthenticated process.

GOOGLE_API_KEY=your-api-key-here     # required for Gemini models
# AGENT_USE_CASE=assistant           # assistant | pipeline | multi_perspective |
#                                    # refine_until_good | expert_dispatch |
#                                    # team_coordinator | plan_and_execute | approval_gate
# ADK_MODEL=gemini-3.6-flash         # any LiteLLM prefix works: openai/gpt-4o,
#                                    # anthropic/claude-sonnet-4-5, ollama/llama3, ...
# AGENT_INSTRUCTION=
# AGENT_TOOLS=knowledge,search,mcp,openapi,approval,runtime,structured_output
# AGENT_MAX_ITERATIONS=3             # refine_until_good, plan_and_execute
# AGENT_SPECIALISTS=research,solution,risk  # expert_dispatch

# Multi-provider LLMs: any LiteLLM-supported provider works via provider prefix
# (e.g. ADK_MODEL=openai/gpt-4o) or YAML model.provider. Typical env vars:
# OPENAI_API_KEY, ANTHROPIC_API_KEY, OLLAMA_API_BASE (base URL), GROQ_API_KEY,
# MISTRAL_API_KEY, DEEPSEEK_API_KEY.

# Full control (per-role instructions/models/tools, structured config):
# mount a YAML file at /app/config/agent.yaml or set AGENT_CONFIG_FILE.
# See examples/*.yaml and README.md "YAML reference".

# Optional: register custom use cases from a Python module. Production also
# requires AGENT_USE_CASE_MODULE_ALLOWLIST to contain an approved directory.
# AGENT_USE_CASE_MODULE=/path/to/your_module.py

# ── Runtime / infrastructure ─────────────────────────────────────────────────
# One shared image is used by all Python application containers.
APP_IMAGE=basic-adk-agent:local
APP_NAME=basic_agent
APP_VERSION=0.1.0
DEPLOYMENT_ENV=docker-compose
AUTH_DISABLED=false

# Agent description and knowledge/tools detail (advanced).
AGENT_DESCRIPTION=A general-purpose, configuration-driven ADK agent.
AGENT_KNOWLEDGE_FILE=
AGENT_KNOWLEDGE_RESULT_LIMIT=3
AGENT_MCP_TOOLS=get_service_status
AGENT_MCP_TOOL_PREFIX=mcp_
# Agent Skills (SKILL.md folders) — see skills/status-check/SKILL.md for the format.
AGENT_SKILLS_DIR=
AGENT_SKILLS_TOOL_PREFIX=
AGENT_OPENAPI_URL=http://127.0.0.1:8001
AGENT_OPENAPI_PATH=/status
AGENT_OPENAPI_TITLE=Configured Service API
AGENT_OPENAPI_TOOL_PREFIX=api_
AGENT_APPLICATION_TOOL_PREFIX=integration_
AGENT_APPLICATION_TOOL_INSTRUCTIONS=Use this integration only for actions explicitly requested by the user.

# Optional; defaults to gemini-3.6-flash.
ADK_MODEL=gemini-3.6-flash

# Optional; used by the OpenAPI release-status tool.
AGENT_SERVICE_API_URL=http://127.0.0.1:8001
AGENT_SERVICE_API_PORT=8001

# Optional; if set, protects the release-status API with x-api-key.
AGENT_SERVICE_API_KEY=

# Local Keycloak OIDC configuration.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
DEMO_MODE=false                    # true imports the dev-only demo/demo user
KEYCLOAK_ISSUER=http://localhost:8080/realms/basic-agent
# Docker services use this internal URL to fetch Keycloak signing keys.
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/basic-agent/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=basic-agent
KEYCLOAK_ROLE_CLAIM=realm_access.roles
KEYCLOAK_REQUIRED_ROLES=agent-user
AGENT_SERVICE_API_ROLES=agent-user
LIVE_API_ROLES=agent-user

# Optional; ADK REST API host port.
ADK_API_PORT=8002

# Optional bidirectional Live API WebSocket service.
LIVE_API_PORT=8003
LIVE_ADK_MODEL=gemini-3.1-flash-live-preview
LIVE_MAX_MESSAGE_BYTES=1048576
LIVE_MAX_AUDIO_BYTES=786432
LIVE_MAX_MESSAGES_PER_MINUTE=60

# Custom use-case modules: production must set an allowlist of directories.
AGENT_USE_CASE_MODULE=
AGENT_USE_CASE_MODULE_ALLOWLIST=

# Optional automatic capability discovery. No provider/type flags are needed.
# Higher-priority cloud/DB values win over local values, then in-memory fallback.
STORAGE_BUCKET=
DATABASE_URL=
STORAGE_PATH=.adk/storage
MESSAGING_URL=
BROKER_URL=amqp://127.0.0.1:5672
CACHE_URL=
REDIS_URL=
CACHE_PATH=.adk/cache
SEARCH_URL=
SEARCH_API_KEY=
SEARCH_INDEX_PATH=.adk/search-index
LOG_ENDPOINT=
LOG_API_KEY=
LOG_FILE=.adk/agent.log

# Local OpenTelemetry LGTM stack (Grafana, Tempo, Loki, Prometheus).
# Only started with `docker compose --profile observability up`.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317

# Optional Google Cloud Application Integration configuration.
GOOGLE_CLOUD_PROJECT=
GCP_LOCATION=us-central1
GCP_INTEGRATION=
GCP_INTEGRATION_TRIGGERS=
