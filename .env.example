# ── Agent configuration ──────────────────────────────────────────────────────
GOOGLE_API_KEY=your-api-key-here
# LiteLLM model provider: YAML uses model.provider=litellm and
# model.name=provider/model; env-only configuration uses ADK_MODEL=provider/model.
# OPENAI_API_KEY=                    # ADK_MODEL=openai/<model>
# ANTHROPIC_API_KEY=                 # ADK_MODEL=anthropic/<model>
# DEEPSEEK_API_KEY=                  # ADK_MODEL=deepseek/<model>
# GROQ_API_KEY=                      # ADK_MODEL=groq/<model>
# MISTRAL_API_KEY=                   # ADK_MODEL=mistral/<model>
# OPENROUTER_API_KEY=                # ADK_MODEL=openrouter/<provider>/<model>
# OLLAMA_API_BASE=http://127.0.0.1:11434  # ADK_MODEL=ollama/<model>
# OPENAI_API_BASE=                   # optional OpenAI-compatible endpoint
# AGENT_USE_CASE=assistant           # assistant | pipeline | multi_perspective | refine_until_good |
#                                    # expert_dispatch | team_coordinator | plan_and_execute | approval_gate
# ADK_MODEL=gemini-3.6-flash         # provider/model prefix: openai/gpt-4o, anthropic/claude-sonnet-5, ...
# AGENT_INSTRUCTION=                 # custom agent instruction (overrides built-in prompt)
# AGENT_TOOLS=knowledge,search,mcp,approval,runtime,structured_output
# Unknown tools are rejected; state-changing tools default to approval.
# AGENT_READ_ONLY_TOOLS=request_approval,inspect_runtime,retrieve_knowledge,google_search,get_service_status,mcp_get_service_status,api_getconfiguredservicestatus
# AGENT_MUTATING_TOOLS=
# AGENT_MAX_ITERATIONS=3             # refine_until_good, plan_and_execute
# AGENT_SPECIALISTS=research,solution,risk  # expert_dispatch
# AGENT_SKILLS_DIR=                  # path to skills directory (SKILL.md folders)

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_NAME=basic_agent
APP_VERSION=0.1.0
DEPLOYMENT_ENV=docker-compose
AUTH_DISABLED=false
DEMO_MODE=false                    # true imports dev-only demo/demo user (local dev only)

# ── Authentication (Keycloak OIDC) ───────────────────────────────────────────
KEYCLOAK_PORT=8080
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ISSUER=http://localhost:8080/realms/basic-agent
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/basic-agent/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=basic-agent
KEYCLOAK_ROLE_CLAIM=realm_access.roles
KEYCLOAK_REQUIRED_ROLES=agent-user
AGENT_SERVICE_API_ROLES=agent-user
LIVE_API_ROLES=agent-user

# ── Interfaces ───────────────────────────────────────────────────────────────
ADK_API_PORT=8002
LIVE_API_PORT=8003
ADK_API_BIND_ADDRESS=127.0.0.1
LIVE_API_BIND_ADDRESS=127.0.0.1
LIVE_ADK_MODEL=gemini-3.1-flash-live-preview
LIVE_MAX_MESSAGE_BYTES=1048576
LIVE_MAX_AUDIO_BYTES=786432
LIVE_MAX_MESSAGES_PER_MINUTE=60

# ── Tools ────────────────────────────────────────────────────────────────────
AGENT_KNOWLEDGE_FILE=
AGENT_KNOWLEDGE_RESULT_LIMIT=3
AGENT_KNOWLEDGE_MAX_FILE_BYTES=2097152
AGENT_KNOWLEDGE_MAX_RESULT_BYTES=65536
AGENT_MCP_TOOLS=get_service_status
AGENT_MCP_TOOL_PREFIX=mcp_
AGENT_SKILLS_TOOL_PREFIX=
AGENT_OPENAPI_URL=http://127.0.0.1:8001
AGENT_OPENAPI_PATH=/status
AGENT_OPENAPI_TITLE=Configured Service API
AGENT_OPENAPI_TOOL_PREFIX=api_
AGENT_SERVICE_API_URL=http://127.0.0.1:8001
AGENT_SERVICE_API_KEY=

# ── Code execution sandbox ───────────────────────────────────────────────────
# Add code_execution to AGENT_TOOLS. Strategy auto-detected unless pinned.
AGENT_CODE_EXECUTION_STRATEGY=
AGENT_CODE_EXECUTION_DOCKER_HOST=            # tcp://code-exec-socket-proxy:2375 (compose --profile code-exec)
AGENT_CODE_EXECUTION_DOCKER_IMAGE=           # default python:3.13-slim@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a
AGENT_CODE_EXECUTION_VERTEX_RESOURCE=        # projects/…/locations/…/extensions/…
AGENT_CODE_EXECUTION_AGENT_ENGINE_RESOURCE=  # projects/…/locations/…/reasoningEngines/…
AGENT_CODE_EXECUTION_GKE_KUBECONFIG_PATH=
AGENT_CODE_EXECUTION_GKE_KUBECONFIG_CONTEXT=

# ── Application Integration (GCP) ───────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GCP_LOCATION=us-central1
GCP_INTEGRATION=
GCP_INTEGRATION_TRIGGERS=

# ── Observability ────────────────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317

# ── Custom use cases ─────────────────────────────────────────────────────────
AGENT_USE_CASE_MODULE=
AGENT_USE_CASE_MODULE_ALLOWLIST=

# ── Capability discovery (optional) ──────────────────────────────────────────
STORAGE_BUCKET=
DATABASE_URL=
STORAGE_PATH=.adk/storage
CACHE_URL=
REDIS_URL=
CACHE_PATH=.adk/cache
SEARCH_URL=
SEARCH_API_KEY=
LOG_ENDPOINT=
LOG_FILE=.adk/agent.log
